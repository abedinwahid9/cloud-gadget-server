model Order {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String   @unique

  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId

  items       OrderItem[]   // 🔥 One-to-many

  pricing     Pricing
  shipping    ShippingAddress

  status      OrderStatus @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String   @db.ObjectId

  productId   String   @db.ObjectId
  productName String
  productImage String?
  vendorId    String?  @db.ObjectId

  quantity    Int
  price       Float
  subtotal    Float

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
}

type Pricing {
  subtotal        Float   // sum of item subtotals
  discount        Float   // coupon / campaign discount
  shippingFee     Float
  tax             Float
  grandTotal      Float   // final payable amount

  currency        String  // BDT, USD
}

type ShippingAddress {
  fullName  String
  mobile    String
  address   String
  upazila   String
  district  String
}


enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUTFORDELIVERY
  DELIVERED
  CANCELLED
}